# Ключ Claude API для ИИ-наставника: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Бесплатные модели Groq для тестов: https://console.groq.com/keys
# Если задан GROQ_API_KEY, наставник работает через Groq (LLM_PROVIDER=groq|anthropic — выбрать явно)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Токен для /admin (база знаний). Без него админка открыта только при локальной разработке
ADMIN_TOKEN=
